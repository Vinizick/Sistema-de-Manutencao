{
  "version": 2,
  "builds": [
    { "src": "server.js", "use": "@vercel/node" },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/login.html",        "dest": "/public/login.html" },
    { "src": "/usuarios.html",     "dest": "/public/usuarios.html" },
    { "src": "/cadastro.html",     "dest": "/public/cadastro.html" },
    { "src": "/equipamentos.html", "dest": "/public/equipamentos.html" },
    { "src": "/(.*)",              "dest": "server.js" }
  ]
}